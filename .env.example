# Public site URL (used in metadata, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://aaywa.org

# ---- Contact form (POST /api/contact) ----
# Leave unset and the form shows an honest "not enabled yet" notice.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — default is AAYWA Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# ---- Newsletter (POST /api/newsletter) ----
# Choose one provider: resend | brevo | mailchimp
NEWSLETTER_PROVIDER=
RESEND_API_KEY=
NEWSLETTER_AUDIENCE_ID=
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
